<resources>

    <!-- Base application theme: Enforce dark Material palette so text never turns black on selection -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#0D1117</item>
        <item name="android:navigationBarColor">#0D1117</item>
        <item name="android:windowBackground">#0D1117</item>
        <item name="android:textColor">#E6EDF3</item>
        <item name="android:textColorPrimary">#E6EDF3</item>
        <item name="android:textColorSecondary">#8B949E</item>
        <item name="android:textColorHighlight">#4D58A6FF</item>
        <item name="android:editTextColor">#E6EDF3</item>
        <item name="colorAccent">#58A6FF</item>
        <item name="colorControlActivated">#58A6FF</item>
        <item name="colorControlHighlight">#2658A6FF</item>
    </style>

</resources>
